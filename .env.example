# Copia este archivo como .env y ajusta los valores.
# Clave secreta para firmar sesiones (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

# MySQL de XAMPP (usuario root sin contraseña por defecto)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=athletehub

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Pon 1 cuando uses HTTPS (cookies solo por conexión segura)
SESSION_COOKIE_SECURE=0
# Minutos de validez del QR de asistencia
QR_MINUTOS=15
# 1 = detrás de Cloudflare Tunnel (confía en las cabeceras del proxy)
TRUST_PROXY=0

# Contraseñas de los usuarios de prueba que crea init_db.py (solo desarrollo local).
# Deben tener 8+ caracteres, mayúscula, minúscula, número y símbolo.
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
